{
  "name": "mtxpg",
  "version": "0.5",
  "description": "Schema-per-tenant multitenancy for SAP CAP on PostgreSQL",
  "main": "index.js",
  "files": [
    "src/srv/**",
    "src/db/**",
    "src/middleware/**",
    "src/utils/**",
    "src/adapter/**",
    "index.js"
  ],
  "scripts": {
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "test:integration": "jest --runInBand --selectProjects integration"
  },
  "peerDependencies": {
    "@sap/cds": ">=8",
    "@cap-js/postgres": ">=1"
  },
  "devDependencies": {
    "axios": "^1.7.0",
    "jest": "^29.7.0",
    "pg": "^8.11.0"
  },
  "cds": {
    "folders": {
      "srv": "./src/srv",
      "db": "./src/db"
    }
  },
  "keywords": ["sap", "cds", "cap", "multitenancy", "PostgreSQL", "mtx", "mtx-pg"]
}
